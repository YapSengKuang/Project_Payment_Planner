{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "project-payment-planner",
  "compatibility_date": "2026-10-15",
  "build": {
    "command": "npm run build:release"
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "workers_dev": true,
  "previews": {}
}
